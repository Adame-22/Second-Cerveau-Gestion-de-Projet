# Copié en .env par installer.sh. Ne jamais publier le fichier .env.

# Adresse de ton DocuSeal : un sous-domaine qui pointe vers l'IP du serveur.
HOST=signature.exemple.fr

# Mot de passe de la base de données (lettres et chiffres uniquement).
# installer.sh en génère un automatiquement.
POSTGRES_PASSWORD=
